---
import AvailabilityBadge from "../components/AvailabilityBadge.astro";
import { links, profile } from "../data/site";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Mike Miller — Product Leader",
    description = "Senior Product Manager specializing in platform products, AI workflows, developer experience, and enterprise software.",
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
    if (href === "/") return pathname === "/";
    if (href === "/work")
        return pathname.startsWith("/work") || pathname.startsWith("/projects");
    if (href === "/thinking")
        return pathname.startsWith("/thinking") || pathname.startsWith("/ai");
    return pathname.startsWith(href);
};

const navItems = [
    { href: links.work, label: "Work" },
    { href: links.about, label: "About" },
    { href: links.resume, label: "Resume" },
    { href: links.tinybots, label: "Tinybots" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-nav">
            <div class="container nav-inner">
                <a class="site-logo" href={links.home}>Mike Miller</a>
                <nav aria-label="Primary navigation">
                    {
                        navItems.map((item) => (
                            <a
                                class:list={{ active: isActive(item.href) }}
                                href={item.href}
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
                <a class="nav-cta arrow-link" href={links.contact}
                    >Contact me <span>→</span></a
                >
            </div>
        </header>

        <slot />

        <footer class="site-footer">
            <div class="container footer-grid">
                <section class="footer-bio">
                    <a class="site-logo" href={links.home}>{profile.name}</a>
                    <p>
                        Product leader building platform products, AI workflows,
                        and small software that respects users.
                    </p>
                    <AvailabilityBadge label="Open to new roles" />
                </section>
                <section>
                    <h2>Links</h2>
                    <a href={links.work}>Work</a>
                    <a href={links.about}>About</a>
                    <a href={links.tinybots}>Tinybots</a>
                    <a href={links.resume}>Resume</a>
                </section>
                <section>
                    <h2>Connect</h2>
                    <a href={links.linkedin} target="_blank" rel="noopener"
                        >LinkedIn</a
                    >
                    <a href={links.twitter} target="_blank" rel="noopener"
                        >Twitter/X</a
                    >
                    <a href={links.github} target="_blank" rel="noopener"
                        >GitHub</a
                    >
                    <a href={links.email}>Email</a>
                </section>
            </div>
            <div class="container footer-bottom">
                <p>© {new Date().getFullYear()} Mike Miller</p>
                <nav aria-label="Footer utility links">
                    <a href="/">Privacy</a>
                    <a href="/">Terms</a>
                    <a href="/">Sitemap</a>
                </nav>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --teal: #0f766e;
        --teal-dark: #0d3330;
        --teal-card: #0f4c47;
        --teal-light: #f0fdf4;
        --charcoal: #111827;
        --muted: #6b7280;
        --surface: #f8f8f8;
        --surface-strong: #f3f4f6;
        --border: #e5e7eb;
        --white: #ffffff;
        --green: #059669;
        --amber: #d97706;
        --max-width: 1400px;
        --page-padding: 48px;
        --radius: 12px;
        --shadow: 0 24px 60px rgba(17, 24, 39, 0.14);
    }

    html {
        font-size: 16px;
        scroll-behavior: smooth;
    }

    body {
        min-width: 320px;
        color: var(--charcoal);
        background: var(--white);
        font-family:
            Inter,
            -apple-system,
            BlinkMacSystemFont,
            sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

    body::selection {
        background: rgba(15, 118, 110, 0.18);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    img {
        display: block;
        max-width: 100%;
    }

    button {
        font: inherit;
    }

    .container {
        width: min(var(--max-width), calc(100% - (var(--page-padding) * 2)));
        margin: 0 auto;
    }

    .site-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        height: 64px;
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(8px);
    }

    .nav-inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        height: 64px;
    }

    .site-logo {
        color: var(--charcoal);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .site-logo:hover,
    .site-nav a:hover,
    .site-footer a:hover {
        color: var(--teal);
    }

    .site-nav nav {
        display: flex;
        align-items: center;
        gap: 34px;
    }

    .site-nav nav a {
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
        transition: color 0.16s ease;
    }

    .site-nav nav a.active {
        color: var(--charcoal);
        font-weight: 650;
    }

    .nav-cta {
        justify-self: end;
        color: var(--teal);
        font-size: 14px;
        font-weight: 600;
    }

    .arrow-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .arrow-link span,
    .project-action b span,
    .thinking-card b span {
        transition: transform 0.16s ease;
    }

    .arrow-link:hover span,
    .project-row:hover .project-action b span,
    .thinking-card:hover b span {
        transform: translateX(4px);
    }

    .page-section {
        padding: 96px 0;
    }

    .page-section--light {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .page-hero {
        padding: 104px 0 88px;
    }

    .page-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.58fr) minmax(360px, 0.42fr);
        gap: 80px;
        align-items: center;
    }

    .page-hero h1,
    .hero-title {
        max-width: 840px;
        color: var(--charcoal);
        font-size: clamp(48px, 5.5vw, 88px);
        font-weight: 820;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .page-hero h1 span,
    .hero-title span {
        color: #374151;
        font-weight: 300;
    }

    .page-hero p,
    .hero-copy {
        max-width: 680px;
        margin-top: 32px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.75;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        color: var(--teal);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .eyebrow::before {
        content: "";
        width: 20px;
        height: 1.5px;
        background: currentColor;
    }

    .eyebrow--dark {
        color: rgba(255, 255, 255, 0.58);
    }

    .chip-list,
    .tag-list,
    .skill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .chip-list {
        margin-top: 36px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        min-height: 36px;
        padding: 7px 16px;
        border: 1.5px solid var(--teal);
        border-radius: 999px;
        color: var(--teal);
        font-size: 13px;
        font-weight: 550;
        transition:
            background 0.16s ease,
            color 0.16s ease,
            transform 0.16s ease;
    }

    .chip:hover {
        background: var(--teal);
        color: var(--white);
        transform: translateY(-1px);
    }

    .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 36px;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 45px;
        padding: 11px 24px;
        border: 1.5px solid var(--teal);
        border-radius: 8px;
        color: var(--teal);
        font-size: 14px;
        font-weight: 650;
        letter-spacing: -0.01em;
        transition:
            transform 0.16s ease,
            box-shadow 0.16s ease,
            background 0.16s ease;
    }

    .button:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 30px rgba(15, 118, 110, 0.16);
    }

    .button--primary {
        background: var(--teal);
        color: var(--white);
    }

    .button--dark-primary {
        border-color: var(--white);
        background: var(--white);
        color: var(--teal-dark);
    }

    .button--dark-outline {
        border-color: rgba(255, 255, 255, 0.38);
        color: var(--white);
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 34px;
    }

    .section-heading h2 {
        max-width: 760px;
        color: var(--charcoal);
        font-size: 36px;
        font-weight: 820;
        letter-spacing: -0.04em;
        line-height: 1.08;
    }

    .section-heading > a {
        color: var(--teal);
        font-size: 14px;
        font-weight: 650;
    }

    .dark-card,
    .dark-panel {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        background:
            repeating-linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.03) 0,
                rgba(255, 255, 255, 0.03) 1px,
                transparent 1px,
                transparent 28px
            ),
            repeating-linear-gradient(
                0deg,
                rgba(255, 255, 255, 0.03) 0,
                rgba(255, 255, 255, 0.03) 1px,
                transparent 1px,
                transparent 28px
            ),
            linear-gradient(135deg, var(--teal-card), #134e4a);
        color: var(--white);
        box-shadow: var(--shadow);
    }

    .dark-card {
        padding: 40px;
    }

    .dark-card--animated {
        background: linear-gradient(135deg, var(--teal-card), #134e4a);
    }

    .dark-card--animated > :not(.animated-grid-bg) {
        position: relative;
        z-index: 1;
    }

    .dark-panel {
        padding: 72px;
    }

    .dark-panel h2,
    .dark-card h2,
    .dark-card h3 {
        color: var(--white);
        letter-spacing: -0.04em;
    }

    .dark-panel p,
    .dark-card p {
        color: rgba(255, 255, 255, 0.7);
    }

    .identity-card header {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .identity-card img {
        width: 56px;
        height: 56px;
        border: 1.5px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
        object-fit: cover;
    }

    .identity-card strong {
        display: block;
        color: var(--white);
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .identity-card small {
        color: rgba(255, 255, 255, 0.55);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .identity-stats {
        display: grid;
        margin: 30px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .identity-stats div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .identity-stats strong {
        font-size: 30px;
    }

    .identity-stats span {
        color: rgba(255, 255, 255, 0.62);
        font-size: 14px;
    }

    .dark-skill {
        display: inline-flex;
        padding: 5px 14px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-style: normal;
        font-weight: 550;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .metric-band {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .metric-band .metric-grid {
        width: min(var(--max-width), calc(100% - (var(--page-padding) * 2)));
        margin: 0 auto;
        border-top: 0;
        border-bottom: 0;
    }

    .metric-cell {
        min-height: 158px;
        padding: 44px 48px;
        border-right: 1px solid var(--border);
    }

    .metric-cell:last-child {
        border-right: 0;
    }

    .metric-cell strong {
        display: block;
        color: var(--teal);
        font-size: 42px;
        font-weight: 820;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .metric-cell span {
        display: block;
        margin-top: 10px;
        color: var(--charcoal);
        font-size: 14px;
        font-weight: 650;
    }

    .metric-grid--compact {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
    }

    .metric-grid--compact .metric-cell {
        min-height: auto;
        padding: 24px 22px;
    }

    .metric-grid--compact .metric-cell strong {
        font-size: 31px;
    }

    .project-list {
        border-top: 1.5px solid var(--charcoal);
    }

    .reveal-list .reveal-item {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.6s ease,
            transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
    }

    .reveal-list.is-visible .reveal-item {
        opacity: 1;
        transform: translateY(0);
    }

    .reveal-list .project-row {
        transition:
            opacity 0.6s ease,
            transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
            background 0.16s ease,
            margin 0.16s ease,
            padding 0.16s ease;
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-list .reveal-item {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    .project-row {
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: 48px;
        align-items: center;
        padding: 36px 0;
        border-bottom: 1px solid var(--border);
        transition:
            background 0.16s ease,
            margin 0.16s ease,
            padding 0.16s ease;
    }

    .project-row[hidden] {
        display: none;
    }

    .project-row:hover {
        margin: 0 -24px;
        padding-right: 24px;
        padding-left: 24px;
        background: var(--surface);
    }

    .project-number {
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
    }

    .project-content {
        display: grid;
        gap: 12px;
    }

    .project-content strong {
        color: var(--charcoal);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
    }

    .project-content > span:not(.tag-list) {
        max-width: 720px;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.55;
    }

    .tag-list em {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 4px;
        background: var(--surface-strong);
        color: var(--muted);
        font-size: 11px;
        font-style: normal;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .project-action {
        display: grid;
        justify-items: end;
        gap: 16px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
    }

    .project-action b {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--teal);
        font-size: 14px;
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 48px 0 40px;
    }

    .filter-bar button {
        padding: 8px 18px;
        border: 1.5px solid var(--border);
        border-radius: 999px;
        background: var(--white);
        color: var(--muted);
        cursor: pointer;
        font-size: 13px;
        font-weight: 650;
        transition:
            border-color 0.16s ease,
            color 0.16s ease,
            background 0.16s ease;
    }

    .filter-bar button:hover {
        border-color: var(--teal);
        color: var(--teal);
    }

    .filter-bar button.is-active {
        border-color: var(--teal);
        background: var(--teal);
        color: var(--white);
    }

    .thinking-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
        overflow: hidden;
        border-radius: 12px;
        background: var(--border);
    }

    .thinking-card {
        display: grid;
        min-height: 310px;
        padding: 36px 32px;
        background: var(--white);
        transition: background 0.16s ease;
    }

    .thinking-card:hover {
        background: #fbfbfb;
    }

    .thinking-card > span {
        color: var(--teal);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .thinking-card strong {
        margin-top: 22px;
        color: var(--charcoal);
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.18;
    }

    .thinking-card p {
        margin-top: 16px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.65;
    }

    .thinking-card footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        align-self: end;
        margin-top: 30px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
    }

    .thinking-card b {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--teal);
        font-size: 13px;
    }

    .availability-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        padding: 7px 14px;
        border: 1px solid #a7f3d0;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal);
        font-size: 12px;
        font-weight: 750;
    }

    .availability-badge--dark {
        border-color: rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.82);
    }

    .availability-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #34d399;
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.4;
        }
    }

    .info-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 32px;
        background: var(--white);
    }

    .fact-grid {
        display: grid;
    }

    .fact-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid var(--border);
    }

    .fact-row:last-child {
        border-bottom: 0;
    }

    .fact-row dt {
        color: var(--muted);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .fact-row dd {
        color: var(--charcoal);
        font-size: 15px;
        font-weight: 760;
    }

    .site-footer {
        border-top: 1px solid var(--border);
        background: var(--white);
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr;
        gap: 64px;
        padding: 64px 0 54px;
    }

    .footer-grid section {
        display: grid;
        align-content: start;
        gap: 12px;
    }

    .footer-grid h2 {
        margin-bottom: 4px;
        color: var(--charcoal);
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .footer-grid a:not(.site-logo),
    .footer-grid p {
        color: var(--muted);
        font-size: 14px;
    }

    .footer-bio p {
        max-width: 360px;
        line-height: 1.7;
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        padding: 20px 0 28px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
    }

    .footer-bottom nav {
        display: flex;
        gap: 20px;
    }

    @media (max-width: 1200px) {
        .page-hero-grid {
            grid-template-columns: 1fr;
        }

        .dark-card {
            max-width: 620px;
        }
    }

    @media (max-width: 900px) {
        :root {
            --page-padding: 24px;
        }

        .page-section {
            padding: 72px 0;
        }

        .page-hero {
            padding: 72px 0;
        }

        .site-nav nav {
            display: none;
        }

        .nav-inner {
            grid-template-columns: 1fr auto;
        }

        .nav-cta {
            font-size: 13px;
        }

        .metric-grid,
        .thinking-grid,
