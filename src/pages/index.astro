---
import AnimatedGridBackground from "../components/AnimatedGridBackground.astro";
import AvailabilityBadge from "../components/AvailabilityBadge.astro";
import DarkPanel from "../components/DarkPanel.astro";
import MetricGrid from "../components/MetricGrid.astro";
import ProjectRows from "../components/ProjectRows.astro";
import Layout from "../layouts/Layout.astro";
import {
    links,
    metrics,
    profile,
    thinkingArticles,
    personalStats,
    workItems,
} from "../data/site";

const selectedWork = workItems.slice(0, 3);
---

<Layout>
    <main>
        <section class="page-hero home-hero">
            <div class="container page-hero-grid">
                <div>
                    <p class="eyebrow">{profile.status}</p>
                    <h1>
                        Product thinking <br />at <span>platform scale.</span>
                    </h1>
                    <p>
                        I build products that scale — from 10k to 200k users,
                        from single-team tools to developer platforms. Senior PM
                        specializing in AI workflows, platform products, and
                        enterprise software.
                    </p>
                    <div class="chip-list">
                        {
                            profile.specialties.map((specialty) => (
                                <a class="chip" href={links.work}>
                                    ✓ {specialty}
                                </a>
                            ))
                        }
                    </div>
                </div>

                <aside
                    class="dark-card identity-card dark-card--animated"
                    aria-label="Mike Miller career statistics"
                >
                    <AnimatedGridBackground />
                    <header>
                        <img
                            src={profile.avatar}
                            alt={profile.name}
                            width="56"
                            height="56"
                        />
                        <div>
                            <strong>{profile.name}</strong>
                            <small>Product Leader</small>
                        </div>
                    </header>
                    <div class="identity-stats">
                        {
                            metrics.map((metric) => (
                                <div>
                                    <strong>{metric.value}</strong>
                                    <span>{metric.label}</span>
                                </div>
                            ))
                        }
                    </div>
                    <div class="skill-list">
                        <em class="dark-skill">Startup</em>
                        <em class="dark-skill">Growth</em>
                        <em class="dark-skill">Enterprise</em>
                    </div>
                </aside>
            </div>
        </section>

        <MetricGrid metrics={personalStats} animated />

        <section class="page-section">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Selected Work</p>
                        <h2>What I've built</h2>
                    </div>
                    <a class="arrow-link" href={links.work}
                        >View all work <span>→</span></a
                    >
                </div>
                <ProjectRows projects={selectedWork} action="Read" animated />
            </div>
        </section>

        <!-- <section class="page-section page-section--light">
            <div class="container">
                <DarkPanel label="Product Philosophy" title="Product as craft.">
                    <p class="philosophy-lede">
                        The best products aren't built — they're cultivated.
                        Every decision compounds over time, every edge case is a
                        signal, every user frustration is an invitation to go
                        deeper.
                    </p>
                    <a class="button button--dark-outline" href={links.thinking}
                        >Read my thinking →</a
                    >
                </DarkPanel>
            </div>
        </section> -->

        <section class="page-section page-section--light">
            <div class="container cta-band">
                <div>
                    <p class="eyebrow">Available</p>
                    <h2>
                        Building platform products, AI workflows, or something
                        from zero?
                    </h2>
                </div>
                <div class="cta-actions">
                    <a class="button button--primary" href={links.contact}
                        >Let's talk →</a
                    >
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
.home-hero {
    min-height: 716px;
    display: flex;
    align-items: center;
}

.home-hero .eyebrow {
    color: var(--teal-dark);
}

    .philosophy-lede {
        max-width: 900px;
        margin: 28px 0 34px;
        font-size: clamp(28px, 3vw, 46px);
        font-style: italic;
        font-weight: 300;
        letter-spacing: -0.04em;
        line-height: 1.16;
    }

    .cta-band {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 40px;
        align-items: center;
    }

    .cta-band h2 {
        max-width: 760px;
        font-size: 38px;
        font-weight: 820;
        letter-spacing: -0.04em;
        line-height: 1.08;
    }

    .cta-actions {
        display: grid;
        justify-items: end;
        gap: 16px;
    }

    @media (max-width: 900px) {
        .home-hero {
            min-height: auto;
        }

        .cta-band {
            grid-template-columns: 1fr;
        }

        .cta-actions {
            justify-items: start;
        }
    }
</style>
