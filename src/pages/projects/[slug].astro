---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={`${project.data.name} — Mike Miller`}>
  <main>
    <section class="project-detail-hero">
      <div class="container">
        <a class="back-link arrow-link" href="/work"><span>←</span> Back to work</a>
        <p class="eyebrow">{project.data.type}</p>
        <h1>{project.data.name}</h1>
        <p>{project.data.description}</p>
        {project.data.liveDemoUrl && (
          <a class="button button--primary" href={project.data.liveDemoUrl} target="_blank" rel="noopener">
            Live Demo ↗
          </a>
        )}
      </div>
    </section>

    <section class="project-detail-body">
      <div class="container content-shell">
        <Content />
      </div>
    </section>
  </main>
</Layout>

<style>
  .project-detail-hero {
    padding: 72px 0 64px;
    border-bottom: 1.5px solid var(--charcoal);
  }

  .back-link {
    display: flex;
    width: fit-content;
    margin-bottom: 40px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
  }

  .project-detail-hero .eyebrow {
    display: flex;
    width: fit-content;
    margin-bottom: 28px;
  }

  .project-detail-hero h1 {
    max-width: 980px;
    color: var(--charcoal);
    font-size: clamp(48px, 5vw, 76px);
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .project-detail-hero p:not(.eyebrow) {
    max-width: 760px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .project-detail-hero .button {
    margin-top: 30px;
  }

  .project-detail-body {
    padding: 72px 0 96px;
  }

  .content-shell {
    max-width: 920px;
  }

  .content-shell :global(h2) {
    margin: 52px 0 18px;
    color: var(--charcoal);
    font-size: 34px;
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .content-shell :global(h2:first-child) {
    margin-top: 0;
  }

  .content-shell :global(h3) {
    margin: 36px 0 12px;
    color: var(--charcoal);
    font-size: 22px;
    font-weight: 760;
    letter-spacing: -0.03em;
  }

  .content-shell :global(p) {
    margin-bottom: 20px;
    color: #4b5563;
    font-size: 17px;
    line-height: 1.85;
  }

  .content-shell :global(ul),
  .content-shell :global(ol) {
    display: grid;
    gap: 10px;
    margin: 18px 0 28px;
    padding-left: 22px;
  }

  .content-shell :global(li) {
    color: #4b5563;
    font-size: 16px;
    line-height: 1.75;
  }

  .content-shell :global(li::marker) {
    color: var(--teal);
  }

  .content-shell :global(a) {
    color: var(--teal);
    font-weight: 700;
  }

  .content-shell :global(img) {
    width: 100%;
    height: auto;
    margin: 34px 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 18px 42px rgba(17, 24, 39, 0.08);
  }
</style>
