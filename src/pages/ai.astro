---
import DarkPanel from "../components/DarkPanel.astro";
import ProjectRows from "../components/ProjectRows.astro";
import Layout from "../layouts/Layout.astro";
import { aiProjects, links, thinkingArticles } from "../data/site";

const principles = [
    {
        label: "Discovery",
        title: "Start with the failure mode",
        body: "Before scoping an AI feature, I map every way it can fail — hallucination, drift, edge case, adversarial input. The product is designed around those boundaries.",
    },
    {
        label: "Prioritization",
        title: "Design for the 80% case first",
        body: "AI systems that try to handle everything handle nothing well. Nail the dominant use case with high confidence before expanding scope.",
    },
    {
        label: "Measurement",
        title: "Measure trust, not just accuracy",
        body: "A 95% accurate model users don't trust is worthless. I instrument for trust signals — overrides, corrections, and abandonment.",
    },
];

const philosophy = [
    "Trust before capability",
    "Graceful failure > perfect success",
    "Explainability is a feature",
    "Humans stay in the loop",
];
---

<Layout title="AI Workflows — Mike Miller">
    <main>
        <section class="page-hero ai-hero">
            <div class="container page-hero-grid">
                <div>
                    <p class="eyebrow">AI · Workflows · Automation</p>
                    <h1>Building AI that works in the real world.</h1>
                    <p>
                        Not demos. Production AI — embedded in enterprise
                        workflows, used daily by real teams, designed around
                        trust and explainability.
                    </p>
                    <div class="chip-list">
                        <a class="chip" href={links.work}
                            >AI Product Management</a
                        >
                        <a class="chip" href={links.work}>Workflow Automation</a
                        >
                    </div>
                </div>

                <aside class="dark-card ai-card">
                    <p class="eyebrow eyebrow--dark">Philosophy</p>
                    <h2>AI PM Philosophy</h2>
                    <ol>
                        {
                            philosophy.map((item, index) => (
                                <li>
                                    <span>
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                    <strong>{item}</strong>
                                </li>
                            ))
                        }
                    </ol>
                    <div class="skill-list">
                        <em class="dark-skill">LLMs</em>
                        <em class="dark-skill">MLOps</em>
                        <em class="dark-skill">Prompt Eng</em>
                    </div>
                </aside>
            </div>
        </section>

        <section class="page-section page-section--light">
            <div class="container principle-grid">
                {
                    principles.map((principle) => (
                        <article class="principle-card">
                            <span>{principle.label}</span>
                            <h2>{principle.title}</h2>
                            <p>{principle.body}</p>
                        </article>
                    ))
                }
            </div>
        </section>

        <section class="page-section">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">AI Case Studies</p>
                        <h2>Applied AI, not theater</h2>
                    </div>
                    <a class="arrow-link" href={links.work}
                        >All work <span>→</span></a
                    >
                </div>
                <ProjectRows projects={aiProjects.slice(0, 3)} />
            </div>
        </section>

        <section class="page-section page-section--light">
            <div class="container">
                <DarkPanel
                    label="Operating Principle"
                    title="Capability is not the bottleneck. Trust is."
                >
                    <p class="ai-quote">
                        AI product work is the discipline of making
                        probabilistic systems usable inside deterministic
                        expectations.
                    </p>
                    <p>
                        The work is less about promising magic and more about
                        making uncertainty visible, recoverable, measurable, and
                        honest enough that teams can rely on it.
                    </p>
                </DarkPanel>
            </div>
        </section>
    </main>
</Layout>

<style>
    .ai-card h2 {
        margin-bottom: 28px;
        font-size: 24px;
        font-weight: 820;
    }

    .ai-card ol {
        display: grid;
        margin: 0 0 22px;
        padding: 0;
        list-style: none;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .ai-card li {
        display: grid;
        grid-template-columns: 36px 1fr;
        gap: 14px;
        align-items: center;
        padding: 17px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .ai-card li:last-child {
        border-bottom: 0;
    }

    .ai-card li span {
        color: #5eead4;
        font-size: 12px;
        font-weight: 800;
    }

    .ai-card li strong {
        color: rgba(255, 255, 255, 0.88);
        font-size: 15px;
        font-weight: 700;
    }

    .principle-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .principle-card {
        min-height: 240px;
        padding: 36px 32px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--white);
        transition:
            transform 0.16s ease,
            box-shadow 0.16s ease;
    }

    .principle-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 36px rgba(17, 24, 39, 0.08);
    }

    .principle-card span {
        color: var(--teal);
        font-size: 11px;
        font-weight: 760;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .principle-card h2 {
        margin-top: 18px;
        color: var(--charcoal);
        font-size: 22px;
        font-weight: 820;
        letter-spacing: -0.035em;
        line-height: 1.18;
    }

    .principle-card p {
        margin-top: 16px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.7;
    }

    .ai-quote {
        max-width: 980px;
        margin: 28px 0 22px;
        font-size: clamp(30px, 3vw, 48px);
        font-style: italic;
        font-weight: 300;
        letter-spacing: -0.04em;
        line-height: 1.16;
    }

    @media (max-width: 900px) {
        .principle-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
