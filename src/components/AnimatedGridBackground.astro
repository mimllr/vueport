---
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
    class:list={["animated-grid-bg", className]}
    data-animated-grid
    aria-hidden="true"
>
    <canvas></canvas>
</div>

<script>
    const GRID_SPACING = 28;
    const REPEL_RADIUS = 110;
    const REPEL_STRENGTH = 32;
    const WAVE_INTERVAL = 14000;
    const WAVE_DURATION = 4500;
    const WAVE_AMPLITUDE = 14;

    type MouseState = {
        x: number;
        y: number;
        active: boolean;
    };

    function easeInOut(t: number) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function getWaveBlend(time: number) {
        const cycle = time % WAVE_INTERVAL;
        if (cycle >= WAVE_DURATION) return 0;
        return easeInOut(cycle / WAVE_DURATION);
    }

    function repelOffset(
        linePos: number,
        mousePos: number,
        active: boolean,
    ) {
        if (!active) return 0;
        const dist = Math.abs(linePos - mousePos);
        if (dist > REPEL_RADIUS) return 0;
        const t = 1 - dist / REPEL_RADIUS;
        const push = t * t * REPEL_STRENGTH;
        return linePos < mousePos ? -push : push;
    }

    function lineOpacity(time: number, index: number, blend: number) {
        const pulse = 0.5 + 0.5 * Math.sin(time * 0.0011 + index * 0.65);
        const base = 0.018 + pulse * 0.028;
        return base * (1 - blend * 0.35) + blend * 0.04;
    }

    function shouldWave(index: number, time: number, blend: number) {
        if (blend <= 0) return false;
        const seed = Math.floor(time / WAVE_INTERVAL) % 5;
        return Math.abs((index % 5) - seed) <= 1;
    }

    function initGrid(root: HTMLElement) {
        const canvas = root.querySelector("canvas");
        const card = root.closest(".dark-card");
        if (!canvas || !card) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const mouse: MouseState = { x: 0, y: 0, active: false };
        let width = 0;
        let height = 0;
        let dpr = 1;
        let raf = 0;
        let visible = true;
        let reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const resize = () => {
            const rect = card.getBoundingClientRect();
            width = rect.width;
            height = rect.height;
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.max(1, Math.floor(width * dpr));
            canvas.height = Math.max(1, Math.floor(height * dpr));
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };

        const drawStaticGrid = () => {
            ctx.clearRect(0, 0, width, height);
            ctx.strokeStyle = "rgba(255, 255, 255, 0.03)";
            ctx.lineWidth = 1;

            for (let x = 0; x <= width; x += GRID_SPACING) {
                ctx.beginPath();
                ctx.moveTo(x + 0.5, 0);
                ctx.lineTo(x + 0.5, height);
                ctx.stroke();
            }

            for (let y = 0; y <= height; y += GRID_SPACING) {
                ctx.beginPath();
                ctx.moveTo(0, y + 0.5);
                ctx.lineTo(width, y + 0.5);
                ctx.stroke();
            }
        };

        const drawLine = (
            points: Array<[number, number]>,
            opacity: number,
        ) => {
            if (points.length < 2) return;
            ctx.strokeStyle = `rgba(255, 255, 255, ${opacity})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(points[0][0], points[0][1]);
            for (let i = 1; i < points.length; i++) {
                ctx.lineTo(points[i][0], points[i][1]);
            }
            ctx.stroke();
        };

        const draw = (time: number) => {
            if (!visible) return;

            const waveBlend = getWaveBlend(time);
            const driftX =
                Math.sin(time * 0.00028) * 7 + Math.sin(time * 0.00011) * 3;
            const driftY =
                Math.cos(time * 0.00024) * 5 + Math.cos(time * 0.00013) * 2;

            ctx.clearRect(0, 0, width, height);

            const colStart = Math.floor(-GRID_SPACING / GRID_SPACING) - 1;
            const colEnd = Math.ceil(width / GRID_SPACING) + 1;
            const rowStart = Math.floor(-GRID_SPACING / GRID_SPACING) - 1;
            const rowEnd = Math.ceil(height / GRID_SPACING) + 1;

            for (let i = colStart; i <= colEnd; i++) {
                const rawX = i * GRID_SPACING + driftX;
                const baseX = rawX + repelOffset(rawX, mouse.x, mouse.active);
                const opacity = lineOpacity(time, i, waveBlend);
                const wavy = shouldWave(i, time, waveBlend);

                if (wavy) {
                    const points: Array<[number, number]> = [];
                    const step = 4;
                    for (let y = 0; y <= height; y += step) {
                        const wave =
                            Math.sin(y * 0.045 + time * 0.0018 + i * 0.4) *
                            WAVE_AMPLITUDE *
                            waveBlend;
                        points.push([baseX + wave, y]);
                    }
                    drawLine(points, opacity);
                } else {
                    drawLine(
                        [
                            [baseX, 0],
                            [baseX, height],
                        ],
                        opacity,
                    );
                }
            }

            for (let j = rowStart; j <= rowEnd; j++) {
                const rawY = j * GRID_SPACING + driftY;
                const baseY = rawY + repelOffset(rawY, mouse.y, mouse.active);
                const opacity = lineOpacity(time, j + 100, waveBlend);
                const wavy = shouldWave(j + 50, time, waveBlend);

                if (wavy) {
                    const points: Array<[number, number]> = [];
                    const step = 4;
                    for (let x = 0; x <= width; x += step) {
                        const wave =
                            Math.sin(x * 0.045 + time * 0.0016 + j * 0.35) *
                            WAVE_AMPLITUDE *
                            waveBlend;
                        points.push([x, baseY + wave]);
                    }
                    drawLine(points, opacity);
                } else {
                    drawLine(
                        [
                            [0, baseY],
                            [width, baseY],
                        ],
                        opacity,
                    );
                }
            }
        };

        const loop = (time: number) => {
            if (reducedMotion) {
                drawStaticGrid();
                return;
            }
            draw(time);
            raf = requestAnimationFrame(loop);
        };

        const onPointerMove = (event: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            mouse.x = event.clientX - rect.left;
            mouse.y = event.clientY - rect.top;
            mouse.active = true;
        };

        const onPointerLeave = () => {
            mouse.active = false;
        };

        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        const onMotionChange = (event: MediaQueryListEvent) => {
            reducedMotion = event.matches;
            if (reducedMotion) {
                cancelAnimationFrame(raf);
                drawStaticGrid();
            } else {
                cancelAnimationFrame(raf);
                raf = requestAnimationFrame(loop);
            }
        };

        const observer = new IntersectionObserver(
            (entries) => {
                visible = entries[0]?.isIntersecting ?? true;
                if (!visible) {
                    cancelAnimationFrame(raf);
                    return;
                }
                if (!reducedMotion) {
                    cancelAnimationFrame(raf);
                    raf = requestAnimationFrame(loop);
                }
            },
            { threshold: 0.05 },
        );

        resize();
        if (reducedMotion) {
            drawStaticGrid();
        } else {
            raf = requestAnimationFrame(loop);
        }

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(card);
        observer.observe(card);
        card.addEventListener("pointermove", onPointerMove);
        card.addEventListener("pointerleave", onPointerLeave);
        motionQuery.addEventListener("change", onMotionChange);
        window.addEventListener("resize", resize);

        return () => {
            cancelAnimationFrame(raf);
            resizeObserver.disconnect();
            observer.disconnect();
            card.removeEventListener("pointermove", onPointerMove);
            card.removeEventListener("pointerleave", onPointerLeave);
            motionQuery.removeEventListener("change", onMotionChange);
            window.removeEventListener("resize", resize);
        };
    }

    document.querySelectorAll("[data-animated-grid]").forEach((root) => {
        if (root instanceof HTMLElement) initGrid(root);
    });
</script>

<style>
    .animated-grid-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        border-radius: inherit;
        pointer-events: none;
    }

    .animated-grid-bg canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
