---
type CarouselImage = {
  src: string;
  alt: string;
};

interface Props {
  images: CarouselImage[];
}

const { images } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="carousel" data-carousel id={carouselId}>
  <button class="carousel-button" type="button" data-prev aria-label="Previous image">
    ←
  </button>

  <div class="carousel-track" data-track>
    {images.map((image) => (
      <figure class="carousel-slide">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </figure>
    ))}
  </div>

  <button class="carousel-button" type="button" data-next aria-label="Next image">
    →
  </button>
</div>

<script is:inline>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    if (carousel.dataset.bound === 'true') return;
    carousel.dataset.bound = 'true';

    const track = carousel.querySelector('[data-track]');
    const prev = carousel.querySelector('[data-prev]');
    const next = carousel.querySelector('[data-next]');

    if (!track || !prev || !next) return;

    const scrollAmount = () => track.clientWidth * 0.9;

    prev.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    next.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  });
</script>

<style>
  .carousel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin: 2rem 0;
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.25rem 0;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 min(320px, 80vw);
    margin: 0;
    scroll-snap-align: center;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .carousel-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: #111827;
    cursor: pointer;
    font: inherit;
  }

  .carousel-button:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  @media (max-width: 640px) {
    .carousel {
      grid-template-columns: 1fr;
    }

    .carousel-button {
      display: none;
    }

    .carousel-slide {
      flex-basis: min(280px, 78vw);
    }
  }
</style>
