---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
  compact?: boolean;
}

const { metrics, compact = false } = Astro.props;
---

{compact ? (
  <div class="metric-grid metric-grid--compact">
    {metrics.map((metric) => (
      <div class="metric-cell">
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))}
  </div>
) : (
  <section class="metric-band">
    <div class="metric-grid">
      {metrics.map((metric) => (
        <div class="metric-cell">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))}
    </div>
  </section>
)}
