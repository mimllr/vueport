---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
  compact?: boolean;
}

const { metrics, compact = false } = Astro.props;
---

<div class:list={['metric-grid', { 'metric-grid--compact': compact }]}>
  {metrics.map((metric) => (
    <div class="metric-cell">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </div>
  ))}
</div>
